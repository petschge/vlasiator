#!/bin/bash
#SBATCH --time=2-00:00:00     # Run time (d-hh:mm:ss)
#SBATCH --job-name=double_harris
#SBATCH --constraint=carrington,c
#S#BATCH -p small
#SBATCH --nodes=1
#SBATCH -c 4                  # CPU cores per task
#SBATCH --ntasks-per-node=16
#SBATCH --hint=multithread
#SBATCH --mem-per-cpu=5G      # memory per core

. ~/.bashrc
. ~/ptenv.sh
export PTNOINTERACTIVE=1

export LD_LIBRARY_PATH=/home/pkilian/vlasiator_ES/libraries-turso-amd_GNU_MPICH/lib/:$LD_LIBRARY_PATH

#Carrington has 2 x 16 cores per node, plus hyperthreading
ht=2
t=$SLURM_CPUS_PER_TASK
export OMP_NUM_THREADS=4 # $t

module purge
module -I load PrgEnv-gnu/15.2.0
module -I load MPICH/5.0.1
module -I load bzip2
module -I load CMake
module -I load HY_proxy
module -I load Automake
module -I load git

executable="/home/pkilian/vlasiator_ES/vlasiator"
configfile="./${SLURM_JOB_NAME}.cfg"
umask 007
cd $SLURM_SUBMIT_DIR
wait

mkdir run_$SLURM_JOB_NAME
cp $configfile run_$SLURM_JOB_NAME
cd run_$SLURM_JOB_NAME

hostname
ldd $executable
md5sum $executable
srun -n 1 -N 1 $executable --version
srun -n $SLURM_NTASKS -N $SLURM_NNODES $executable --run_config=$configfile

../charge_diag.py > charge_diag_${SLURM_JOB_NAME}.log
../reconnected_flux.py > reconnected_flux_${SLURM_JOB_NAME}.log
../gem_figures.py --t9 19.4 --t10 19.4 40 --t11 19.4 40 --t12 19.4 40 --t13 19.4 40 ;
../stripes.py > stripes.log


